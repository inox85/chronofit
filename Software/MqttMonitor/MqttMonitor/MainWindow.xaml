<Window
    x:Class="MqttMonitor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Icon="/Resources/favicon.ico"
    Title="MQTT Monitor"
    Width="1552"
    Height="650"
    Background="#1E1E2E"
    Foreground="#CCCCDD">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0E0E1A" />
            <Setter Property="Foreground" Value="#CCCCDD" />
            <Setter Property="BorderBrush" Value="#333350" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="#CCCCDD" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="28" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1A1A28" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="#1E1E30" />
            <Setter Property="Foreground" Value="#9F9FBB" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#22223A" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ColumnHeaderHeight" Value="30" />
            <Setter Property="RowHeight" Value="28" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="EnableRowVirtualization" Value="True" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0E0E1A" />
            <Setter Property="Foreground" Value="#6E6E8A" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="BorderBrush" Value="#22223A" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#9F9FBB" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1D9E7522" />
                    <Setter Property="Foreground" Value="#CCCCDD" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#F5F5F5" />
            <Setter Property="Foreground" Value="#222222" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1D9E7522" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel
        LastChildFill="True"
        >
        <!--  Toolbar  -->
        <Border
            Height="60"
            Padding="12,8"
            Background="#16161E"
            BorderBrush="#22223A"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <WrapPanel VerticalAlignment="Center" Orientation="Horizontal">
                <Image
                    Width="147"
                    Height="26"
                    Margin="6,6,12,6"
                    Source="/Resources/logo.png"/>
                <TextBlock
                    Margin="6,0,6,0"
                    VerticalAlignment="Center"
                    FontSize="22"
                    Foreground="#6E6E8A"
                    Text="Broker" />
                <TextBox
                    x:Name="TxtHost"
                    Width="230"
                    Height="35"
                    FontSize="22"
                    Text="broker.hivemq.com" />

                <TextBlock
                    Margin="6,0,6,0"
                    VerticalAlignment="Center"
                    FontSize="22"
                    Foreground="#6E6E8A"
                    Text="Port" />
                <TextBox
                    x:Name="TxtPort"
                    Width="65"
                    Height="35"
                    FontSize="22"
                    Text="1883" />

                <TextBlock
                    Margin="6,0,6,0"
                    VerticalAlignment="Center"
                    FontSize="22"
                    Foreground="#6E6E8A"
                    Text="Topic" />
                <TextBox
                    x:Name="TxtTopic"
                    Width="200"
                    Height="35"
                    Margin="0,0,10,0"
                    FontSize="22"
                    Text="chronofit/#" />

                <Button
                    x:Name="BtnConnect"
                    Height="35"
                    Margin="0,0,6,0"
                    Background="#1D9E75"
                    Click="BtnConnect_Click"
                    Content="Connect"
                    FontSize="22"
                    Foreground="White" />
                <Button
                    x:Name="BtnDisconnect"
                    Height="35"
                    Margin="0,0,6,0"
                    Background="#993C1D"
                    Click="BtnDisconnect_Click"
                    Content="Disconnect"
                    FontSize="22"
                    Foreground="White"
                    IsEnabled="False" />
                <Button
                    Width="127"
                    Height="35"
                    Background="#3A3A50"
                    Click="BtnClear_Click"
                    Content="Clear"
                    FontSize="22"
                    Foreground="#AAAACC" />

                <!--  Status indicator  -->
                
            </WrapPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Height="30" Background="#16161E">
            <WrapPanel VerticalAlignment="Center" Orientation="Horizontal">
                <Ellipse
                    x:Name="StatusDot"
                    Width="16"
                    Height="16"
                    Margin="6,0,6,0"
                    VerticalAlignment="Center"
                    Fill="#993C1D" />
                                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    FontSize="22"
                    Foreground="#6E6E8A"
                    Text="Disconnected" />
            </WrapPanel>
        </Border>

        <DataGrid
            x:Name="GridMessages"
            AutoGenerateColumns="False"
            ColumnWidth="SizeToCells"
            FontSize="20"
            SelectionChanged="GridMessages_SelectionChanged">

            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="FontSize" Value="20" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Background" Value="#333333" />
                </Style>
            </DataGrid.Resources>

            <DataGrid.CellStyle>
                <Style />
            </DataGrid.CellStyle>

            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="55"
                    Binding="{Binding Index}"
                    Header="#" />
                <DataGridTextColumn
                    Width="110"
                    Binding="{Binding TimestampDisplay}"
                    Header="Received at" />
                <DataGridTextColumn
                    Width="220"
                    Binding="{Binding Topic}"
                    Header="Topic" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding ID}"
                    Header="ID" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding LineNumber}"
                    Header="Line number" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding LineID}"
                    Header="Line ID" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding TimeStamp}"
                    Header="Event time" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Payload}"
                    Header="Payload" />

            </DataGrid.Columns>
        </DataGrid>


    </DockPanel>
</Window>
